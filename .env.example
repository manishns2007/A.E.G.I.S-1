# A.E.G.I.S. Environment Configuration
# 
# Add your Gemini API key here. This is read server-side only.
# The frontend never sees or transmits this key.
# 
# To use: set this before starting the backend:
#   Windows PowerShell:  $env:GEMINI_API_KEY = "your-key"
#   Linux/Mac:           export GEMINI_API_KEY="your-key"
#
# Alternatively, create a .env file and run: python-dotenv (pip install python-dotenv)

GEMINI_API_KEY=
